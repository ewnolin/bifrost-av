#!/usr/bin/env bash
# pre-push — Guard a push (run tests, block WIP, protect branches).
# When: On `git push`, before any objects are transferred.
# Args: $1 = remote name · $2 = remote URL. Refs to push arrive on stdin.
# Exit: Non-zero aborts the push.
echo "pre-push: running build and tests..."
./gradlew build -q || {
  echo "Build failed. Push aborted."
  exit 1
}
exit 0
